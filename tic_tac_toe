#   PROJECT  Tic-Tac-Toe
# Scenario
# Your task is to write a simple program which pretends to play tic-tac-toe with the user.
# To make it all easier for you, we've decided to simplify the game. Here are our assumptions:
# • the computer (i.e., your program) should play the game using 'X's;
# • the user (e.g., you) should play the game using 'O's;
# • the first move belongs to the computer − it always puts its first 'X' in the middle of the board;
# • all the squares are numbered row by row starting with 1 (see the example session below for reference)
# • the user inputs their move by entering the number of the square they choose − the number must be valid, i.e.,
# it must be an integer, it must be greater than 0 and less than 10, and it cannot point to a field which is already occupied;
# • the program checks if the game is over − there are four possible verdicts: the game should continue,
# the game ends with a tie, you win, or the computer wins;
# • the computer responds with its move and the check is repeated;
# • don't implement any form of artificial intelligence − a random field choice made by the computer is good enough for the game.

###############################################

from random import randrange

board = [[0 for row in range(3)] for column in range(3)]

board[0][0] = 1
board[0][1] = 2
board[0][2] = 3
board[1][0] = 4
board[1][1] = "X"
board[1][2] = 6
board[2][0] = 7
board[2][1] = 8
board[2][2] = 9

john_list = []

countdown = 0


###############################################

def display_board(board):
    print(f"""
+-------+-------+-------+
|       |       |       |
|   {board[0][0]}   |   {board[0][1]}   |   {board[0][2]}   |
|       |       |       |
+-------+-------+-------+
|       |       |       |
|   {board[1][0]}   |   {board[1][1]}   |   {board[1][2]}   |
|       |       |       |
+-------+-------+-------+
|       |       |       |
|   {board[2][0]}   |   {board[2][1]}   |   {board[2][2]}   |
|       |       |       |
+-------+-------+-------+
        """)
    
    # The function accepts one parameter containing the board's current status
    # and prints it out to the console.

def enter_move(board):
    global countdown
    
    move = input("What is your next move?: ")
    try:
        move = int(move)

        if move == 1 and board[0][0] == 1:
            board[0][0] = "O"
            countdown += 1
            
        elif move == 2  and board[0][1] == 2:
            board[0][1] = "O"
            countdown += 1
            
        elif move == 3  and board[0][2] == 3:
            board[0][2] = "O"
            countdown += 1
            
        elif move == 4  and board[1][0] == 4:
            board[1][0] = "O"
            countdown += 1
            
        elif move == 6  and board[1][2] == 6:
            board[1][2] = "O"
            countdown += 1
            
        elif move == 7  and board[2][0] == 7:
            board[2][0] = "O"
            countdown += 1
            
        elif move == 8  and board[2][1] == 8:
            board[2][1] = "O"
            countdown += 1
            
        elif move == 9  and board[2][2] == 9:
            board[2][2] = "O"
            countdown += 1
            
    except:
        print("Illegal move, try again.")
    
    # The Final Project Requirements are below
    ##########################################
    # The function accepts the board's current status, asks the user about their move, 
    # checks the input, and updates the board according to the user's decision.


def make_list_of_free_fields(board): 
    john_list.clear()
    for i in range(3):        
        for j in range(3):
            if board[i][j] != "O" and board[i][j] != "X":
                john_tuple = (i, j)
                john_list.append(john_tuple)

    # The Final Project Requirements are below
    ##########################################
    # The function browses the board and builds a list of all the free squares; 
    # the list consists of tuples, while each tuple is a pair of row and column numbers.

def victory_for(board, sign):
    
    if board[0][0] == sign and board[0][1] == sign and board[0][2] == sign:
    # Top row
        return True    
        
    elif board[1][0] == sign and board[1][1] == sign and board[1][2] == sign:
    # Middle row
        return True    
    
    elif board[2][0] == sign and board[2][1] == sign and board[2][2] == sign:
    # Bottom row
        return True    
        
    elif board[0][0] == sign and board[1][0] == sign and board[2][0] == sign:
    # Left column
        return True

    elif board[0][1] == sign and board[1][1] == sign and board[2][1] == sign:
    # Middle column
        return True

    elif board[0][2] == sign and board[1][2] == sign and board[2][2] == sign:
    # Right column
        return True

    elif board[0][0] == sign and board[1][1] == sign and board[2][2] == sign:
    # \ Diagonal
        return True
    
    elif board[0][2] == sign and board[1][1] == sign and board[2][0] == sign:
    # / Diagonal
        return True

    else:
        return False
    
    # There HAS to be a better way to do this then a giant fucking cascade
    # it feels so brute force. But I don't know of a better way to do it atm
    # and I already made this pain in the ass
    
    # The Final Project Requirements are below
    ##########################################
    # The function analyzes the board's status in order to check if 
    # the player using 'O's or 'X's has won the game


def draw_move(board):
    global countdown
    make_list_of_free_fields(board)
    for i in range(1):
        john_a = john_list[randrange(len(john_list))]
        board[john_a[0]][john_a[1]] = "X"
    countdown += 1
    
    # The Final Project Requirements are below
    ##########################################
    # The function draws the computer's move and updates the board.

while True: 
    display_board(board)
    enter_move(board)
    print("Computer turn: ")
    draw_move(board)
    display_board(board)
    if victory_for(board, "X") == True:
        print("The Script wins.")
        break
    elif victory_for(board, "O") == True:
        print("You win.")
        break
    elif countdown == 8:
        print("You're both losers, tie game.")
        break
    else:
        continue
