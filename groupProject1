        # This part has no error handling at the moment, its a bit of a problem.
            
    interval = input(f"Alright {name}, how often do you get paid? (Daily, Weekly, Biweekly, Monthly, Yearly): ").strip()
    
    while True:
        try:
            l = interval.lower()
