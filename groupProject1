def keepGoing():
    while True:
        global finish, first
        print("", sep="")
        q = input("Do you wish to keep using this program? (Y/N)").strip()
        if q.lower() in agree:
            print("Let's move onto next Month then.")
            first = False
            now =+ 1
            break
        elif q.lower() in disagree:
            print("Alright then, closing the program now.")
            first = False
            finish = True
            break
        else:
            print("Sorry, didn't quite understand that.")
    
