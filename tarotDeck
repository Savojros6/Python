# This is called whenever you confirm you do
# want to reshuffle the deck
def reset():
    global outOfCards, finishedDeck
    print("Alright, reshuffling.")
    outOfCards = False
    for d in range(len(finishedDeck)):
        d = finishedDeck[0]
        discard.append(d)
        del finishedDeck[0]
    print("Reshuffling cards.")
    shuffle()
    mirror()

