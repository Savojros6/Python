# This creates a list of the numbers 1 - 78 in a random order with no duplicates.
# it uses that list to randomly select cards from an orderly list
# to move them into a disorderly one. In order to do it more efficiently
# it checks if the card is already there first, and it deletes it from
# the original list so it wont read it again.
def shuffle():
    global masterHand, crazyHand, finishedDeck
    if first == True:
        print("Shuffling cards.")
    else:
        print("Reshuffling cards..")

    masterHand = [i + 1 for i in range (len(tarotDeck))]
    while len(crazyHand) != len(tarotDeck):  
        x = len(masterHand)
        c = randint (0, x)
        if c not in crazyHand and c == x and x > 0:
            continue 
        elif c not in crazyHand and c != x and x > 0:
            d = masterHand[c]
            crazyHand.append(d)
            del masterHand[c]
        else:
            continue   

# This sequence is necessary for the tarot cards to be able to be
# drawn 'reversed' properly. However its necessary even without
# that part. Since it moves crazyHands values into finishedDeck
# a complete, shuffled deck of cards. This decks existance
# is very temporary, since the values are really just purged and
# recreated each shuffle.
def mirror():
    global first, masterHand, crazyHand, tarotDeck, coinflips, finishedDeck, discard
    if first == True:
        print("Shuffling cards..")
    else:
        print("Reshuffling cards...")
#         print(len(finishedDeck))
#         print(len(tarotDeck))
    
    for a in range (len(tarotDeck)):
        b = crazyHand[a]
        b = b - 1
        
        # this means this is the random card corresponding to the numbers randomized before
        # it has to be 1 lower because '78' exceeds the length of the array below.
        c = tarotDeck[b]
        # this is now actively selecting one random card                
        masterHand.append(c)
        # this is writing this random order to the masterHand list

    for i in range(len(tarotDeck)):
        x = randint (0, 1)
        coinflips.append(x)           
        if coinflips[i] == 1 and kind ==  "Tarot":
            finishedDeck.append(f"{masterHand[i]} - (Reversed)")
        else:
            finishedDeck.append(masterHand[i])

#     print(f"masterHand: {masterHand}")
#     print(f"crazyHand: {crazyHand}")
#     print(f"coinflips: {coinflips}")
    del masterHand[:]
    del crazyHand[:]
    del coinflips[:]
    del discard[:]

